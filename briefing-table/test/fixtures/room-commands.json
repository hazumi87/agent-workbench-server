    { "note": "a seat named user wins mid-text too (and the lead is not added)", "input": "ping @user and @owner", "seats": "userseats", "user": "owner",
      "expect": { "type": "chat", "to": ["s-user", "s-owner"] } },
    { "note": "a /command operand @user is not a seat", "input": "/remove @user", "seats": "default", "user": "owner",
      "expect": { "type": "refused", "error": "@user is the user, not a seat", "suggestion": "name a seat: @<handle>" } },
    { "note": "[address only] User's a line: a seat named mid-text -> only that seat", "input": "I had to halt the run. @kiosk can you check the cuff", "seats": "default",
      "expect": { "type": "chat", "to": "s-kiosk" } },
    { "note": "[address only] two seats named mid-text -> both, not the lead", "input": "please have @kiosk and @home-ops compare", "seats": "default",
      "expect": { "type": "chat", "to": ["s-kiosk", "s-ha"] } },
    { "note": "[address only] names nobody, unaddressedToLead off -> no seat", "input": "please review the plan", "seats": "default", "unaddressedToLead": false,
      "expect": { "type": "chat", "to": [] } },
    { "note": "[address only] names nobody, off, and no lead -> no seat (not refused)", "input": "please review the plan", "seats": "nolead", "unaddressedToLead": false,
      "expect": { "type": "chat", "to": [] } },
    { "note": "[address only] a seat named mid-text needs no lead", "input": "please loop in @kiosk", "seats": "nolead",
      "expect": { "type": "chat", "to": "s-kiosk" } },
    { "note": "[address only] @room mid-text is text, not the room", "input": "tell the @room later", "seats": "default",
      "expect": { "type": "chat", "to": "s-sketcher", "leadDefault": true } },
    { "note": "[address only] an @name in inline code is quoted, not addressed", "input": "run `ping @kiosk` when ready", "seats": "default",
      "expect": { "type": "chat", "to": "s-sketcher", "leadDefault": true } },
    { "note": "[address only] an @name in a fenced block is quoted", "input": "the log said ```@kiosk failed``` again", "seats": "default",
      "expect": { "type": "chat", "to": "s-sketcher", "leadDefault": true } },
    { "note": "[address only] code quoted, a real name outside it still addresses", "input": "see `@sketcher-swarm` and ask @kiosk", "seats": "default",
      "expect": { "type": "chat", "to": "s-kiosk" } },
    { "note": "[address only] an email is not an address", "input": "mail noreply@example.com about it", "seats": "default",
      "expect": { "type": "chat", "to": "s-sketcher", "leadDefault": true } },
    { "note": "[address only] a URL with an @ path is not an address", "input": "see https://example.com/@kiosk for it", "seats": "default",
      "expect": { "type": "chat", "to": "s-sketcher", "leadDefault": true } },
    { "note": "floor take (ends every held turn in the room)", "input": "/floor take", "seats": "default",
      "expect": { "type": "room", "verb": "floor-take", "target": "room", "args": {} } },
    { "note": "floor skip a seat", "input": "/floor skip @kiosk", "seats": "default",
      "expect": { "type": "room", "verb": "floor-skip", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": {} } },
    { "note": "floor with no subcommand is refused", "input": "/floor", "seats": "default",
      "expect": { "type": "refused", "error": "take or skip?", "suggestion": "/floor take or /floor skip @<handle>" } },
    { "note": "set turn in minutes", "input": "/set turn 3", "seats": "default",
      "expect": { "type": "room", "verb": "set-turn", "target": "room", "args": { "minutes": 3 } } },
    { "note": "set turn back to the default", "input": "/set turn default", "seats": "default",
      "expect": { "type": "room", "verb": "set-turn", "target": "room", "args": { "minutes": null } } },
    { "note": "set turn with a non-number is refused", "input": "/set turn soon", "seats": "default",
      "expect": { "type": "refused", "error": "a turn time is a whole number of minutes, 1 to 120 (or \"default\")", "suggestion": "/set turn 5" } },
    { "note": "seat restart a seat", "input": "/seat restart @kiosk", "seats": "default",
      "expect": { "type": "room", "verb": "seat-restart", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": {} } },
    { "note": "seat restart all", "input": "/seat restart all", "seats": "default",
      "expect": { "type": "room", "verb": "seat-restart-all", "target": "room", "args": {} } },
    { "note": "seat restart stop", "input": "/seat restart stop", "seats": "default",
      "expect": { "type": "room", "verb": "seat-restart-stop", "target": "room", "args": {} } },
    { "note": "seat with no subcommand is refused", "input": "/seat", "seats": "default",
      "expect": { "type": "refused", "error": "restart what?", "suggestion": "/seat restart @<handle>" } },
    { "note": "set store: an address (case kept)", "input": "/set store http://100.64.0.1:8215", "seats": "default",
      "expect": { "type": "room", "verb": "set-store", "target": "room", "args": { "address": "http://100.64.0.1:8215" } } },
    { "note": "set store default clears it", "input": "/set store default", "seats": "default",
      "expect": { "type": "room", "verb": "set-store", "target": "room", "args": { "address": null } } },
    { "note": "set store with no address is refused", "input": "/set store", "seats": "default",
      "expect": { "type": "refused", "error": "which address?", "suggestion": "/set store http://host:8215 (or /set store default)" } }
  ]
}
