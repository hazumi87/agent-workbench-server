    { "note": "@User, any case, trailing punctuation", "input": "@User: the build is green", "seats": "nolead", "user": "owner",
      "expect": { "type": "chat", "to": [], "toUser": true } },
    { "note": "a seat actually named user wins over the alias", "input": "@user hi", "seats": "userseats", "user": "owner",
      "expect": { "type": "chat", "to": "s-user" } },
    { "note": "a seat actually named like the user's @name wins", "input": "@owner hi", "seats": "userseats", "user": "owner",
