{
  "_doc": "The table for src/server/room-commands.ts parse(text, seats) — the design notes §3, wr §2.5c [ticket]. One row per input with its EXACT expected output. Shared by test/room-commands.test.ts and the room page's completion. seatSets name the rooms a row is parsed against; is_lead marks the lead.",
  "seatSets": {
    "default": [
      { "id": "s-sketcher", "handle": "sketcher", "is_lead": true },
      { "id": "s-ha", "handle": "home-ops", "is_lead": false },
      { "id": "s-kiosk", "handle": "kiosk", "is_lead": false },
      { "id": "s-swarm", "handle": "sketcher-swarm", "is_lead": false }
    ],
    "nolead": [
      { "id": "s-sketcher", "handle": "sketcher", "is_lead": false },
      { "id": "s-kiosk", "handle": "kiosk", "is_lead": false }
    ],
    "empty": [],
    "userseats": [
      { "id": "s-lead", "handle": "sketcher", "is_lead": true },
      { "id": "s-user", "handle": "user", "is_lead": false },
      { "id": "s-owner", "handle": "owner", "is_lead": false }
    ]
  },
  "cases": [
    { "note": "set lead (executed)", "input": "/set lead @home-ops", "seats": "default",
      "expect": { "type": "room", "verb": "set-lead", "target": { "seatId": "s-ha", "handle": "home-ops" }, "args": {} } },
    { "note": "set lead, bare handle", "input": "/set lead home-ops", "seats": "default",
      "expect": { "type": "room", "verb": "set-lead", "target": { "seatId": "s-ha", "handle": "home-ops" }, "args": {} } },
    { "note": "set lead works with no lead (it is how you get one)", "input": "/set lead @kiosk", "seats": "nolead",
      "expect": { "type": "room", "verb": "set-lead", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": {} } },
    { "note": "set lead, typo'd handle", "input": "/set lead @sketchr", "seats": "default",
      "expect": { "type": "refused", "error": "no @sketchr in this room", "suggestion": "did you mean @sketcher?" } },
    { "note": "set lead, unknown handle", "input": "/set lead @nobody", "seats": "default",
      "expect": { "type": "refused", "error": "no @nobody in this room", "suggestion": "members: @sketcher, @home-ops, @kiosk, @sketcher-swarm" } },
    { "note": "set lead, no operand", "input": "/set lead", "seats": "default",
      "expect": { "type": "refused", "error": "which seat?", "suggestion": "/set lead @<handle>" } },
    { "note": "set lead @room — reserved, not a seat", "input": "/set lead @room", "seats": "default",
      "expect": { "type": "refused", "error": "@room is everyone, not a seat", "suggestion": "/set lead @<handle>" } },
    { "note": "set lead in an empty room", "input": "/set lead @x", "seats": "empty",
      "expect": { "type": "refused", "error": "no @x in this room", "suggestion": "this room has no members yet — /add <project>" } },
    { "note": "set policy (executed)", "input": "/set policy @sketcher-swarm pool", "seats": "default",
      "expect": { "type": "room", "verb": "set-policy", "target": { "seatId": "s-swarm", "handle": "sketcher-swarm" }, "args": { "policy": "pool" } } },
    { "note": "set policy, pool with a size", "input": "/set policy @sketcher-swarm pool 20", "seats": "default",
      "expect": { "type": "room", "verb": "set-policy", "target": { "seatId": "s-swarm", "handle": "sketcher-swarm" }, "args": { "policy": "pool", "pool_size": 20 } } },
    { "note": "set policy fresh", "input": "/set policy @kiosk fresh", "seats": "default",
      "expect": { "type": "room", "verb": "set-policy", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": { "policy": "fresh" } } },
    { "note": "set policy, not a policy", "input": "/set policy @kiosk forgetful", "seats": "default",
      "expect": { "type": "refused", "error": "\"forgetful\" is not a policy", "suggestion": "/set policy @<handle> <persistent|fresh|dispatched|pool>" } },
    { "note": "set policy, a size on a non-pool", "input": "/set policy @kiosk fresh 3", "seats": "default",
      "expect": { "type": "refused", "error": "only a pool takes a size, and it is a positive whole number", "suggestion": "/set policy @kiosk pool 4" } },
    { "note": "set <unknown>", "input": "/set colour @kiosk", "seats": "default",
      "expect": { "type": "refused", "error": "\"/set colour\" is not a room command", "suggestion": "/set lead @<handle>, /set policy @<handle> <policy>, /set turn <minutes> or /set store <address>" } },
    { "note": "set <typo>", "input": "/set leed @kiosk", "seats": "default",
      "expect": { "type": "refused", "error": "\"/set leed\" is not a room command", "suggestion": "/set lead" } },
    { "note": "rename room (executed)", "input": "/rename room Voice Hardware", "seats": "default",
      "expect": { "type": "room", "verb": "rename-room", "target": "room", "args": { "name": "Voice Hardware" } } },
    { "note": "rename room, no name", "input": "/rename room", "seats": "default",
      "expect": { "type": "refused", "error": "what should the room be called?", "suggestion": "/rename room <name>" } },
    { "note": "rename a seat (executed)", "input": "/rename @home-ops to @dot-hardware", "seats": "default",
      "expect": { "type": "room", "verb": "rename-seat", "target": { "seatId": "s-ha", "handle": "home-ops" }, "args": { "handle": "dot-hardware" } } },
    { "note": "rename a seat, without 'to'", "input": "/rename @kiosk @barn", "seats": "default",
      "expect": { "type": "room", "verb": "rename-seat", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": { "handle": "barn" } } },
    { "note": "rename to a reserved handle", "input": "/rename @home-ops to @room", "seats": "default",
      "expect": { "type": "refused", "error": "@room is reserved", "suggestion": "/rename @<handle> to @<new-handle>" } },
    { "note": "add (bind-only until summon)", "input": "/add home-ops as @dot-hardware", "seats": "default",
      "expect": { "type": "room", "verb": "add", "target": null, "args": { "project": "home-ops", "handle": "dot-hardware" } } },
    { "note": "add, derived handle", "input": "/add sketcher", "seats": "default",
      "expect": { "type": "room", "verb": "add", "target": null, "args": { "project": "sketcher" } } },
    { "note": "add, no project", "input": "/add", "seats": "default",
      "expect": { "type": "refused", "error": "which project?", "suggestion": "/add <project> [as @<handle>]" } },
    { "note": "add as a reserved handle", "input": "/add sketcher as @lead", "seats": "default",
      "expect": { "type": "refused", "error": "@lead is reserved", "suggestion": "/add <project> [as @<handle>]" } },
    { "note": "replace (bind-only; does not confirm)", "input": "/replace @sketcher", "seats": "default",
      "expect": { "type": "room", "verb": "replace", "target": { "seatId": "s-sketcher", "handle": "sketcher" }, "args": {} } },
    { "note": "replace with a named pane", "input": "/replace @sketcher with recipe:abc#2", "seats": "default",
      "expect": { "type": "room", "verb": "replace", "target": { "seatId": "s-sketcher", "handle": "sketcher" }, "args": { "paneid": "recipe:abc#2" } } },
    { "note": "remove — first form (engine asks to confirm)", "input": "/remove @kiosk", "seats": "default",
      "expect": { "type": "room", "verb": "remove", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": { "confirm": false } } },
    { "note": "remove — typed confirm form", "input": "/remove @kiosk confirm", "seats": "default",
      "expect": { "type": "room", "verb": "remove", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": { "confirm": true } } },
    { "note": "remove, no operand", "input": "/remove", "seats": "default",
      "expect": { "type": "refused", "error": "which seat?", "suggestion": "/remove @<handle>" } },
    { "note": "wake a resting member (idle rest, User 2026-10-04)", "input": "/wake @kiosk", "seats": "default",
      "expect": { "type": "room", "verb": "wake", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": {} } },
    { "note": "wake, no operand", "input": "/wake", "seats": "default",
      "expect": { "type": "refused", "error": "which seat?", "suggestion": "/wake @<handle>" } },
    { "note": "deliver a member's held lines (User 2026-10-11)", "input": "/deliver @kiosk", "seats": "default",
      "expect": { "type": "room", "verb": "deliver", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": { "confirm": false } } },
    { "note": "deliver, typed confirm (the box has typed text: send anyway)", "input": "/deliver @kiosk confirm", "seats": "default",
      "expect": { "type": "room", "verb": "deliver", "target": { "seatId": "s-kiosk", "handle": "kiosk" }, "args": { "confirm": true } } },
    { "note": "deliver, no operand", "input": "/deliver", "seats": "default",
      "expect": { "type": "refused", "error": "which seat?", "suggestion": "/deliver @<handle>" } },
    { "note": "archive — first form", "input": "/archive", "seats": "default",
      "expect": { "type": "room", "verb": "archive", "target": "room", "args": { "confirm": false } } },
    { "note": "archive — typed confirm form", "input": "/archive confirm", "seats": "default",
      "expect": { "type": "room", "verb": "archive", "target": "room", "args": { "confirm": true } } },
    { "note": "dissolve — first form", "input": "/dissolve", "seats": "default",
      "expect": { "type": "room", "verb": "dissolve", "target": "room", "args": { "confirm": false } } },
    { "note": "dissolve — typed confirm form", "input": "/dissolve confirm", "seats": "default",
      "expect": { "type": "room", "verb": "dissolve", "target": "room", "args": { "confirm": true } } },
    { "note": "reopen", "input": "/reopen", "seats": "default",
      "expect": { "type": "room", "verb": "reopen", "target": "room", "args": {} } },
    { "note": "mode", "input": "/mode autonomous", "seats": "default",
      "expect": { "type": "room", "verb": "mode", "target": "room", "args": { "mode": "autonomous" } } },
    { "note": "mode off clears it", "input": "/mode off", "seats": "default",
      "expect": { "type": "room", "verb": "mode", "target": "room", "args": { "mode": null } } },
    { "note": "mode, no value", "input": "/mode", "seats": "default",
      "expect": { "type": "refused", "error": "which mode?", "suggestion": "/mode autonomous" } },
    { "note": "brief set [room brief]", "input": "/brief - **Dev:** the app", "seats": "default",
      "expect": { "type": "room", "verb": "brief", "target": "room", "args": { "text": "- **Dev:** the app" } } },
    { "note": "brief clear", "input": "/brief clear", "seats": "default",
      "expect": { "type": "room", "verb": "brief", "target": "room", "args": { "clear": true } } },
    { "note": "brief alone shows it", "input": "/brief", "seats": "default",
      "expect": { "type": "room", "verb": "brief", "target": "room", "args": { "show": true } } },
    { "note": "help", "input": "/help", "seats": "default",
      "expect": { "type": "room", "verb": "help", "target": null, "args": {} } },
    { "note": "verbs are case-insensitive", "input": "/HELP", "seats": "default",
      "expect": { "type": "room", "verb": "help", "target": null, "args": {} } },
    { "note": "/seam is not in this build", "input": "/seam", "seats": "default",
      "expect": { "type": "refused", "error": "not in this build", "suggestion": null } },
    { "note": "/voice is not in this build", "input": "/voice on", "seats": "default",
      "expect": { "type": "refused", "error": "not in this build", "suggestion": null } },
    { "note": "a room verb with a target is still a room verb, never carried", "input": "/seam @sketcher", "seats": "default",
      "expect": { "type": "refused", "error": "not in this build", "suggestion": null } },
    { "note": "carried: unknown verb with @handle", "input": "/session-summary @sketcher", "seats": "default",
      "expect": { "type": "carried", "text": "/session-summary @sketcher", "to": ["s-sketcher"] } },
    { "note": "carried to two members", "input": "/session-summary @sketcher @kiosk", "seats": "default",
      "expect": { "type": "carried", "text": "/session-summary @sketcher @kiosk", "to": ["s-sketcher", "s-kiosk"] } },
    { "note": "carried to the room", "input": "/compact @room", "seats": "default",
      "expect": { "type": "carried", "text": "/compact @room", "to": "room" } },
    { "note": "carried, @lead resolves to the lead", "input": "/session-summary @lead", "seats": "default",
      "expect": { "type": "carried", "text": "/session-summary @lead", "to": ["s-sketcher"] } },
    { "note": "carried, @lead with no lead (rule 5)", "input": "/session-summary @lead", "seats": "nolead",
      "expect": { "type": "refused", "error": "no lead yet — un-addressed text goes to the lead", "suggestion": "/set lead @sketcher" } },
    { "note": "carried to an unknown handle", "input": "/session-summary @nobody", "seats": "default",
      "expect": { "type": "refused", "error": "no @nobody in this room", "suggestion": "members: @sketcher, @home-ops, @kiosk, @sketcher-swarm" } },
    { "note": "a typo'd room verb WITH a target is refused, never carried (rule 2 guard: edit distance 1, lead 2026-09-23)", "input": "/remvoe @kiosk", "seats": "default",
      "expect": { "type": "refused", "error": "\"/remvoe\" is not a room command", "suggestion": "did you mean /remove?" } },
    { "note": "a typo'd room verb, no target: refused with the room verb", "input": "/archve", "seats": "default",
      "expect": { "type": "refused", "error": "\"/archve\" is not a room command", "suggestion": "did you mean /archive?" } },
    { "note": "an unknown verb 2+ edits from every room verb, with a target, is still carried (rule 2)", "input": "/deploy @kiosk", "seats": "default",
      "expect": { "type": "carried", "text": "/deploy @kiosk", "to": ["s-kiosk"] } },
    { "note": "a typo'd /rename is refused with /rename as the suggestion", "input": "/rname room X", "seats": "default",
      "expect": { "type": "refused", "error": "\"/rname\" is not a room command", "suggestion": "did you mean /rename?" } },
    { "note": "one edit from a SHORT room verb (/mode) with a target is carried: the guard covers 5+ letter verbs only", "input": "/code @kiosk", "seats": "default",
      "expect": { "type": "carried", "text": "/code @kiosk", "to": ["s-kiosk"] } },
    { "note": "a typo'd short verb with no target still gets rule 3's suggestion", "input": "/mdoe autonomous", "seats": "default",
      "expect": { "type": "refused", "error": "\"/mdoe\" is not a room command", "suggestion": "did you mean /mode?" } },
    { "note": "unknown, no target: suggest the nearest room verb", "input": "/archiv", "seats": "default",
      "expect": { "type": "refused", "error": "\"/archiv\" is not a room command", "suggestion": "did you mean /archive?" } },
    { "note": "unknown, no target, nothing near: offer the lead", "input": "/session-summary", "seats": "default",
      "expect": { "type": "refused", "error": "\"/session-summary\" is not a room command", "suggestion": "send it to @sketcher? /session-summary @sketcher" } },
    { "note": "unknown, no target, no lead", "input": "/session-summary", "seats": "nolead",
      "expect": { "type": "refused", "error": "\"/session-summary\" is not a room command", "suggestion": "no lead yet — /set lead @sketcher" } },
    { "note": "@all in a command is refused", "input": "/session-summary @all", "seats": "default",
      "expect": { "type": "refused", "error": "@all is not in this build — cross-room addressing needs the fabric", "suggestion": "use @room for everyone in this room" } },
    { "note": "@all anywhere in chat is refused", "input": "tell @all we are done", "seats": "default",
      "expect": { "type": "refused", "error": "@all is not in this build — cross-room addressing needs the fabric", "suggestion": "use @room for everyone in this room" } },
    { "note": "@all as the address", "input": "@ALL, standup", "seats": "default",
      "expect": { "type": "refused", "error": "@all is not in this build — cross-room addressing needs the fabric", "suggestion": "use @room for everyone in this room" } },
    { "note": "chat, no @ -> the lead", "input": "please review the plan", "seats": "default",
      "expect": { "type": "chat", "to": "s-sketcher", "leadDefault": true } },
    { "note": "chat, no @, no lead (rule 5)", "input": "please review the plan", "seats": "nolead",
      "expect": { "type": "refused", "error": "no lead yet — un-addressed text goes to the lead", "suggestion": "/set lead @sketcher" } },
    { "note": "chat, addressed, with no lead is fine", "input": "@kiosk status?", "seats": "nolead",
      "expect": { "type": "chat", "to": "s-kiosk" } },
    { "note": "chat to @room", "input": "@room pausing until Thursday", "seats": "default",
      "expect": { "type": "chat", "to": "room" } },
    { "note": "chat to @lead", "input": "@lead look at 2984hgkj3 for the answer", "seats": "default",
      "expect": { "type": "chat", "to": "s-sketcher" } },
    { "note": "chat, trailing punctuation on the address", "input": "@sketcher, i approve b", "seats": "default",
      "expect": { "type": "chat", "to": "s-sketcher" } },
    { "note": "@user addresses THE USER, with no user @name known (User 2026-09-28)", "input": "@user are you there", "seats": "default",
      "expect": { "type": "chat", "to": [], "toUser": true } },
    { "note": "chat to a typo'd handle", "input": "@skether hi", "seats": "default",
      "expect": { "type": "refused", "error": "no @skether in this room", "suggestion": "did you mean @sketcher?" } },
    { "note": "an @ mid-sentence (an email) is not an address: nobody named -> the lead", "input": "ask kiosk@example about it", "seats": "default",
      "expect": { "type": "chat", "to": "s-sketcher", "leadDefault": true } },
    { "note": "empty", "input": "   ", "seats": "default",
      "expect": { "type": "refused", "error": "nothing to send", "suggestion": null } },
    { "note": "a bare slash", "input": "/", "seats": "default",
      "expect": { "type": "refused", "error": "an empty command", "suggestion": "/help" } },
    { "note": "two leading @ -> both seats (User 2026-09-27)", "input": "@kiosk @home-ops can you both check", "seats": "default",
      "expect": { "type": "chat", "to": ["s-kiosk", "s-ha"] } },
    { "note": "leading @ plus a seat mentioned later -> both", "input": "@kiosk please sync with @sketcher-swarm on this", "seats": "default",
      "expect": { "type": "chat", "to": ["s-kiosk", "s-swarm"] } },
    { "note": "no leading @, a seat named mid-text -> ONLY that seat, never the lead too (User 2026-10-07, Workrooms)", "input": "please loop in @kiosk.", "seats": "default",
      "expect": { "type": "chat", "to": "s-kiosk" } },
    { "note": "an unknown @word later in the text is just text", "input": "@kiosk ask @nobody later", "seats": "default",
      "expect": { "type": "chat", "to": "s-kiosk" } },
    { "note": "a repeated seat is delivered once", "input": "@kiosk @kiosk, and again @kiosk", "seats": "default",
      "expect": { "type": "chat", "to": "s-kiosk" } },
    { "note": "an unknown handle in the leading run still refuses", "input": "@kiosk @skether hi", "seats": "default",
      "expect": { "type": "refused", "error": "no @skether in this room", "suggestion": "did you mean @sketcher?" } },
    { "note": "@room anywhere in the leading run wins", "input": "@kiosk @room heads up", "seats": "default",
      "expect": { "type": "chat", "to": "room" } },
    { "note": "the user's @name leads -> to the user, no seat (User 2026-09-28)", "input": "@owner hi", "seats": "default", "user": "owner",
      "expect": { "type": "chat", "to": [], "toUser": true } },
    { "note": "the user's @name, any case, trailing punctuation", "input": "@User, the build is green", "seats": "default", "user": "owner",
