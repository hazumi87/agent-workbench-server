      "expect": { "type": "chat", "to": [], "toUser": true } },
    { "note": "@user plus a seat in the leading run -> the seat, and to the user", "input": "@user @kiosk both of you please", "seats": "default", "user": "owner",
      "expect": { "type": "chat", "to": "s-kiosk", "toUser": true } },
    { "note": "without the option @owner is an unknown handle, as before", "input": "@owner hi", "seats": "default",
      "expect": { "type": "refused", "error": "no @owner in this room", "suggestion": "members: @sketcher, @home-ops, @kiosk, @sketcher-swarm" } },
    { "note": "a seat with the same handle wins over the user's @name", "input": "@kiosk hi", "seats": "default", "user": "kiosk",
      "expect": { "type": "chat", "to": "s-kiosk" } },
    { "note": "@user and the user's @name are the same address", "input": "@user hi", "seats": "default", "user": "owner",
