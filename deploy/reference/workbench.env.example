# /etc/workbench/workbench.env  (root:root 0600; systemd reads it as root). Copy, then edit the CHANGE-ME lines.
# Values match the design notes; the data dir moves to /var/lib/workbench and the broker is the wbagent one.
HARBOR_WB_DATA_DIR=/var/lib/workbench
# The HOSTED profile: Host allow-list (421), a required Origin on cookie requests, hosted room files, no voice or fabric. Without this line the engine runs
# in the ordinary profile and those guards are OFF. It needs HARBOR_WB_FILES_DIR below, kept apart from the data dir.
HARBOR_WB_HOSTED=1
HARBOR_WB_FILES_DIR=/var/lib/workbench-files
HARBOR_WB_HOST=127.0.0.1
HARBOR_WB_PORT=8300
# Accounts only: no shared bearer for people.
HARBOR_WB_IDENTITY=strict
HARBOR_WB_NODE=workbench-pilot
# No window host, no fabric, no telemetry.
HARBOR_WB_DESKTOP=none
HARBOR_WB_FABRIC_URL=off
HARBOR_WB_NATS_URL=
HARBOR_WB_ROOM_FABRIC=0
# The broker is systemd's, never the engine's.
HARBOR_WB_BROKER_PORT=8301
HARBOR_WB_BROKER_TOKEN_FILE=/var/lib/workbench/secrets/broker.token
HARBOR_WB_BROKER_AUTOSTART=0
# Agents authenticate to the engine with a per-pane token. The broker runs as another account (wbagent), so the token is
# delivered through the broker's spawn environment (HARBOR_WB_PANE_TOKEN), never a file the agent would have to read.
HARBOR_WB_PANE_TOKENS=1
HARBOR_WB_PANE_TOKEN_DELIVERY=env
# The engine's room tools (MCP server "bt": room_read, room_post, room_roster ...) are OFF on a server engine unless this is 1, and they need pane tokens (above).
# Without this line a Claude seat starts with no way to pull its room (a seat that can be rung but cannot read). Both lines are required, not optional.
HARBOR_WB_BT_MCP=1
# Lets people install tools from a zip ("Install tool" in the app); each tool asks the person first and runs only in a sandboxed frame with the permissions the person allowed.
# Person accounts only (an agent's pane token is refused). Set it to 0 or delete the line to turn installing off: the install routes then answer 404.
HARBOR_WB_PLUGINS=1
# The BUILT web app (the app repo's build output: index.html, assets, csp.json and modules/*/module.json). The engine serves it at /app and builds its
# list of bundled modules (Tasks, Usage, Pictures, ...) from <this dir>/modules. If the directory is missing or has no modules/, /app is empty and
# /api/modules lists NONE of the bundled modules. The default is <engine code>/web-app, which a plain source checkout does not contain.
HARBOR_WB_APP_DIR=/opt/workbench/web-app
# CHANGE-ME: the public name people type, as the proxy serves it. WebAuthn binds sign-in to it.
HARBOR_WB_WEBAUTHN_RPID=workbench.example.com
HARBOR_WB_WEBAUTHN_ORIGIN=https://workbench.example.com
