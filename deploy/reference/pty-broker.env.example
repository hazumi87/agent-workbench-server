# /etc/workbench/pty-broker.env  (root:root 0600). setup-reference.sh writes this with a fresh token; shown here for reference.
PTY_BROKER_HOST=127.0.0.1
PTY_BROKER_PORT=8301
PTY_BROKER_TOKEN=<generated by setup-reference.sh: 48 hex chars; the same value is in /var/lib/workbench/secrets/broker.token>
