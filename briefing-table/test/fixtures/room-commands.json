      "expect": { "type": "chat", "to": "s-kiosk", "toUser": true } },
    { "note": "the user's @name leads, a seat mentioned later is added", "input": "@owner i asked @kiosk to check", "seats": "default", "user": "owner",
      "expect": { "type": "chat", "to": "s-kiosk", "toUser": true } },
    { "note": "the user's @name mid-text -> to the user, no seat (naming the user is addressing; 2026-10-07: no lead copy)", "input": "tell @owner when it lands", "seats": "default", "user": "owner",
      "expect": { "type": "chat", "to": [], "toUser": true } },
