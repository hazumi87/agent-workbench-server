{
  "id": "rig-biped",
  "title": "Rig + idle (biped)",
  "template": true,
  "about": "A T/A-pose biped mesh from the Library -> cleanup, decimate, UVs (kept if the mesh has them), Rigify rig (fingers), weights, 4 s idle, one-root game skeleton, GLB + FBX + meshopt, validated.",
  "input": {
    "kind": "mesh",
    "formats": [
      "glb",
      "gltf",
      "fbx",
      "obj"
    ]
  },
  "gpu": false,
  "host": "gpu-host",
  "params": {
    "target_tris": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 60000,
      "default": 25000,
      "title": "Triangle budget",
      "bind": [
        [
          "decimate",
          "target_tris"
        ]
      ]
    },
    "arm_down": {
      "type": "number",
      "minimum": 20,
      "maximum": 85,
      "default": 55,
      "title": "Idle arm drop (deg)",
      "bind": [
        [
          "anim_idle",
          "arm_down"
        ]
      ]
    },
    "fingers": {
      "type": "boolean",
      "default": true,
      "title": "Finger bones",
      "bind": [
        [
          "rig_rigify",
          "fingers"
        ]
      ]
    },
    "uv_mode": {
      "type": "string",
      "enum": [
        "keep_if_present",
        "smart"
      ],
      "default": "keep_if_present",
      "title": "UVs (keep the model own, or re-unwrap)",
      "bind": [
        [
          "uv_unwrap",
          "mode"
        ]
      ]
    }
  },
  "steps": [
    {
      "step": "import_mesh",
      "params": {
        "src": "{input_path}"
      }
    },
    {
      "step": "cleanup",
      "params": {
        "merge_distance": 0.0001,
        "min_part_ratio": 0.01
      }
    },
    {
      "step": "decimate",
      "params": {
        "target_tris": 25000
      }
    },
    {
      "step": "uv_unwrap",
      "params": {
        "mode": "keep_if_present"
      }
    },
    {
      "step": "rig_rigify",
      "params": {
        "fingers": true
      }
    },
    {
      "step": "skin",
      "params": {}
    },
    {
      "step": "anim_idle",
      "params": {
        "seconds": 4,
        "fps": 30,
        "arm_down": 55,
        "elbow": 15
      }
    },
    {
      "step": "game_rig",
      "params": {}
    },
    {
      "step": "export",
      "params": {
        "name": "{name}",
        "formats": [
          "glb",
          "fbx"
        ]
      }
    },
    {
      "step": "validate",
      "params": {
        "max_bones": 128,
        "max_tris": 60000,
        "clips": [
          "Idle"
        ]
      }
    },
    {
      "step": "meshopt",
      "params": {
        "animations": [
          "Idle"
        ]
      }
    },
    {
      "step": "preview",
      "params": {
        "res": 512,
        "samples": 16
      }
    }
  ],
  "op": "mesh-rig",
  "est_seconds": 90
}
