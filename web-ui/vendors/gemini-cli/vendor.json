{
  "id": "gemini-cli",
  "label": "Gemini CLI",
  "binary": "gemini",
  "mark": "gemini",
  "color": "#4285F4",
  "installUrl": "https://github.com/google-gemini/gemini-cli",
  "install": {
    "win32": "npm install -g @google/gemini-cli",
    "darwin": "npm install -g @google/gemini-cli",
    "linux": "npm install -g @google/gemini-cli"
  },
  "seamVersion": 1,
  "verifiedWith": "0.1",
  "resumable": false,
  "settings": {
    "model": {
      "type": "choice",
      "label": "Default model",
      "options": [
        "gemini-2.5-pro",
        "gemini-2.5-flash"
      ],
      "labels": [
        "2.5 Pro",
        "2.5 Flash"
      ],
      "default": "gemini-2.5-pro",
      "other": true
    },
    "extraArgs": {
      "type": "args",
      "label": "Extra arguments",
      "hint": "Added to every launch, like --verbose",
      "default": ""
    }
  }
}
